# Flow Business — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env.

# Supabase (obrigatório) — projeto do MESTRE DO MVP
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Mesmo valor da anon key (nome que o client do frontend espera)
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Versões sem prefixo VITE_ para o lado SSR (Nitro/process.env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Backend da busca de leads (placeholder até plugar Google Places)
VITE_API_BASE=http://localhost:8000

# Fase 4 — URL base dos sites publicados (/site/<slug>). Só usada no servidor.
# Enquanto não há subdomínio próprio, aponta para a URL do app na Vercel.
# Troque por https://flowleads.flowgenius.com.br quando o DNS estiver pronto.
PUBLIC_SITE_BASE_URL=https://flow-leads-dusky.vercel.app

# Instagram — configuração administrativa (nunca exposta no frontend)
# 1. Coloque apenas a chave em .env ou .env.local:
UNIPILE_API_KEY=
# 2. Execute `npm run setup:instagram`. O comando cadastra o webhook e envia os segredos ao Supabase.
UNIPILE_API_URL=https://api.unipile.com
FLOW_BUSINESS_UNIPILE_REDIRECT_URL=https://lyitsavnqwtsoouhcjie.supabase.co/functions/v1/flow-business-unipile
FLOW_BUSINESS_UNIPILE_WEBHOOK_URL=https://lyitsavnqwtsoouhcjie.supabase.co/functions/v1/flow-business-unipile-webhook
FLOW_BUSINESS_APP_URL=https://flow-leads-dusky.vercel.app

# Uso administrativo (NÃO expor no frontend) — só em ambiente servidor
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_ACCESS_TOKEN=...
