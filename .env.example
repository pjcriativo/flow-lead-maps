# Flow Business - copie para .env e preencha os valores. Nunca envie este arquivo com segredos.

# Supabase (obrigatorio)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Backend e site publicado
VITE_API_BASE=http://localhost:8000
PUBLIC_SITE_BASE_URL=https://flow-leads-dusky.vercel.app
FLOW_BUSINESS_APP_URL=https://flow-leads-dusky.vercel.app

# Instagram - conexao oficial. Todos estes valores ficam apenas no servidor.
# Cadastre exatamente FLOW_BUSINESS_META_REDIRECT_URL no painel da aplicacao.
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
FLOW_BUSINESS_META_REDIRECT_URL=https://lyitsavnqwtsoouhcjie.supabase.co/functions/v1/flow-business-meta
# Gere 32 bytes aleatorios e converta para base64. Nao reutilize chave de cliente.
FLOW_BUSINESS_TOKEN_KEY=
META_INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Integracao anterior (nao usada pela area do cliente)
UNIPILE_API_KEY=
UNIPILE_API_URL=https://api.unipile.com
FLOW_BUSINESS_UNIPILE_REDIRECT_URL=https://lyitsavnqwtsoouhcjie.supabase.co/functions/v1/flow-business-unipile
FLOW_BUSINESS_UNIPILE_WEBHOOK_URL=https://lyitsavnqwtsoouhcjie.supabase.co/functions/v1/flow-business-unipile-webhook

# Uso administrativo - somente servidor
# SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_ACCESS_TOKEN=...
